# Valores de EXEMPLO. Nunca versione credenciais reais. O Vite NÃO recebe segredos do servidor.
# Ambiente local completo (PostgreSQL + Keycloak): docs/LOCAL-DEV.md

# API (papel restrito: sem superusuário, sem BYPASSRLS, sem ownership das tabelas)
# A senha fica FORA da URL (caracteres como / @ : % quebrariam a URL); entre aspas simples.
DATABASE_URL=postgresql://vv_runtime@127.0.0.1:5432/vapt_vupt
DATABASE_PASSWORD='REPLACE_LOCALLY'
# Migrações e administração (dono do schema; nunca use na API)
MIGRATION_DATABASE_URL=postgresql://vv_migrator@127.0.0.1:5432/vapt_vupt
MIGRATION_DATABASE_PASSWORD='REPLACE_LOCALLY'
ADMIN_DATABASE_URL=postgresql://vv_migrator@127.0.0.1:5432/vapt_vupt
ADMIN_DATABASE_PASSWORD='REPLACE_LOCALLY'

# Origem pública da aplicação (apenas origem). HTTPS obrigatório fora de localhost.
APP_ORIGIN=http://localhost:3001

# OIDC (cliente confidencial, Authorization Code + PKCE). Sem estas variáveis a API não inicia.
OIDC_ISSUER=https://identity.example.invalid/realms/vapt
OIDC_CLIENT_ID=vapt-vupt-web
OIDC_CLIENT_SECRET=REPLACE_WITH_SECRET_FROM_PROVIDER
# Somente desenvolvimento: aceita emissor HTTP em localhost.
# OIDC_ALLOW_HTTP=true
# Somente quando a API alcança o provedor por outro endereço (ex.: rede do Docker).
# OIDC_INTERNAL_ORIGIN=http://keycloak:8080

# Sessão (minutos de inatividade e horas absolutas)
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Servir o build do frontend pela própria API (mesmo domínio dos cookies)
WEB_DIST_DIR=dist
# Atrás de proxy reverso confiável:
# TRUST_PROXY=true
API_HOST=127.0.0.1
PORT=3001
