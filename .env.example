# Placeholder values only. Vite does NOT receive server secrets.
DATABASE_URL=postgresql://runtime_user:REPLACE_LOCALLY@127.0.0.1:5432/vapt_vupt
MIGRATION_DATABASE_URL=postgresql://migration_owner:REPLACE_LOCALLY@127.0.0.1:5432/vapt_vupt
OIDC_ISSUER=https://identity.example.invalid/realms/vapt
OIDC_AUDIENCE=vapt-vupt-api
OIDC_JWKS_URL=https://identity.example.invalid/realms/vapt/protocol/openid-connect/certs
API_HOST=127.0.0.1
PORT=3001

# Public SPA configuration (not secrets). Use an OIDC public client with PKCE S256.
# Leave unset for demo-only preview. VITE_OIDC_AUTHORITY must be HTTPS.
# VITE_OIDC_AUTHORITY=https://identity.example.invalid/realms/vapt
# VITE_OIDC_CLIENT_ID=vapt-vupt-web
# Register exact callback: https://your-installation.example/auth/callback
# Reverse proxy /api to Fastify on the same origin; no token is sent to arbitrary hosts.
