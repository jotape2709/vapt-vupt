# Copie para /etc/systemd/system/ e ajuste WorkingDirectory e User (membro do grupo docker).
[Unit]
Description=Vapt-Vupt: backup cifrado fora do servidor
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=vapt
WorkingDirectory=/opt/vapt-vupt/deploy/cloud
ExecStart=/opt/vapt-vupt/deploy/cloud/ops/backup.sh
Nice=10
IOSchedulingClass=idle
