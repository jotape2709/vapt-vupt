# Instalação em NUVEM — modelo SEM valores utilizáveis. Copie para deploy/cloud/.env no servidor,
# preencha, aplique chmod 600 e rode ops/preflight.sh. O .env real nunca entra no Git nem no backup
# de dados: guarde uma cópia cifrada no cofre de senhas do fornecedor (docs/cloud/OPERACAO.md).
# Gere cada segredo com ops/gen-secret.sh e escreva-o ENTRE ASPAS SIMPLES (NOME='valor'): assim o
# Compose e os scripts leem o mesmo valor, mesmo com / @ : % $ #. As senhas do banco nunca entram
# em URLs (a aplicação recebe usuário/host na URL e a senha em variável separada).

VV_PROJECT=vapt-vupt
# Imagem da aplicação com versão fixa (nunca "latest"), construída a partir de deploy/cloud/Dockerfile.
VV_APP_IMAGE=REPLACE_registry.example.invalid/vapt-vupt-app:0.0.0

# Origens públicas (HTTPS, sem caminho). DNS de ambas deve apontar para o servidor.
VV_APP_ORIGIN=https://REPLACE.example.invalid
VV_AUTH_ORIGIN=https://REPLACE-auth.example.invalid
VV_ACME_EMAIL=REPLACE@example.invalid

# Banco (mínimo 24 caracteres; o init do PostgreSQL recusa valores de exemplo)
VV_POSTGRES_PASSWORD='REPLACE'
VV_MIGRATOR_PASSWORD='REPLACE'
VV_RUNTIME_PASSWORD='REPLACE'
VV_KEYCLOAK_DB_PASSWORD='REPLACE'

# Keycloak: admin temporário de inicialização (substituir por conta nominal com MFA e desativar)
VV_KEYCLOAK_BOOTSTRAP_ADMIN=bootstrap-admin
VV_KEYCLOAK_BOOTSTRAP_PASSWORD='REPLACE'
VV_OIDC_CLIENT_SECRET='REPLACE'

# Limites de memória (VPS de 4 GB; ver docs/cloud/CUSTOS.md)
VV_KEYCLOAK_MEMORY=1024m
VV_APP_MEMORY=512m

# Backup cifrado fora do servidor (ops/backup.sh)
# Chave PÚBLICA age do fornecedor; a chave privada NUNCA fica neste servidor.
VV_BACKUP_AGE_RECIPIENT=REPLACE_age1...
VV_BACKUP_DIR=/var/backups/vapt-vupt
VV_BACKUP_LOCAL_KEEP_DAYS=7
# Destino rclone "offsite:<bucket>/<caminho>"; credencial só de escrita (sem exclusão), via variáveis
# RCLONE_CONFIG_OFFSITE_* em deploy/cloud/backup.env (também fora do Git, chmod 600).
VV_BACKUP_REMOTE=offsite:REPLACE-bucket/vapt-vupt
# URL de "heartbeat" do monitor externo (opcional): recebe ping no sucesso e /fail na falha.
VV_BACKUP_HEARTBEAT_URL=
