# Credencial do armazenamento externo de backup (rclone, S3 compatível). Modelo SEM valores.
# Copie para deploy/cloud/backup.env, chmod 600. Use uma chave restrita ao bucket, sem permissão de
# exclusão, e ative retenção/bloqueio de objetos no provedor (docs/cloud/OPERACAO.md).
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=REPLACE
RCLONE_CONFIG_OFFSITE_ENDPOINT=https://REPLACE.example.invalid
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=REPLACE
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=REPLACE
RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
